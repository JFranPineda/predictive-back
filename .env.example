# Copy to .env. Values below are for a local demo; production sets its own.
DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,.trycloudflare.com
# Only for calls straight to Django; the front goes through Vite's proxy.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://ipsa.localhost:5174

# Control plane: tenant registry and licences only.
CONTROL_DATABASE_URL=sqlite:///data/control.sqlite3

# Each customer's database: TENANT_<CODE>_DATABASE_URL, or the registry entry.
TENANT_AMBEV_DATABASE_URL=sqlite:///data/tenant_ambev.sqlite3
DEFAULT_TENANT=ambev
# Each customer by its subdomain: http://ipsa.localhost:5174 → tenant ipsa.
BASE_DOMAIN=localhost

LICENSE_SECRET=change-me

# Files: `local` keeps them under MEDIA_ROOT (relative to the repo).
MEDIA_BACKEND=local
MEDIA_ROOT=data/media

REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=predictive
OBJECT_STORE_KEY=minioadmin
OBJECT_STORE_SECRET=minioadmin
OBJECT_STORE_REGION=us-east-1

__pycache__/
*.py[cod]
.venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
data/*.sqlite3
# WAL mode keeps its log and index next to each database.
data/*.sqlite3-wal
data/*.sqlite3-shm
data/media/
# Copies taken before risky work; never versioned (they hold customer data).
data/backups/
# The on-premise test bench keeps its media, history and env out of data/.
.onprem-test/
/media/
/staticfiles/

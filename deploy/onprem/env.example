# PREDICTIVE en el servidor del cliente (v4 Phase 6).
#
# install.sh copia esta plantilla a /opt/predictive/.env y la completa: no hay
# que editarla a mano. Los valores entre @ los pone el instalador; las
# contraseñas las genera él mismo y no salen de este servidor.

# --- Lo que corre (lo cambia update.sh con cada versión) ---------------------
COMPOSE_PROJECT_NAME=predictive
COMPOSE_FILE=compose.yml
APP_IMAGE=@APP_IMAGE@
WEB_IMAGE=@WEB_IMAGE@
DB_IMAGE=@DB_IMAGE@
REDIS_IMAGE=@REDIS_IMAGE@
VERSION=@VERSION@

# --- El cliente ----------------------------------------------------------------
TENANT=@TENANT@
CUSTOMER_NAME=@CUSTOMER_NAME@
# Nombres y direcciones por los que la planta entra, separados por coma.
PREDICTIVE_SITES=@PREDICTIVE_SITES@
# El que responde a quien entra por IP: la primera IP de la lista, o el primer nombre.
PREDICTIVE_DEFAULT_SNI=@PREDICTIVE_DEFAULT_SNI@

# --- Respaldo diario (P6-b: el destino lo elige el cliente, en su red) ---------
BACKUP_DIR=@BACKUP_DIR@
BACKUP_KEEP_DAYS=@BACKUP_KEEP_DAYS@

# --- Secretos de esta instalación (generados) ----------------------------------
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
PREDICTIVE_DB_PASSWORD=@PREDICTIVE_DB_PASSWORD@
SECRET_KEY=@SECRET_KEY@

# --- La aplicación ---------------------------------------------------------------
# Producción, sin DEBUG: lo fija la imagen (config.settings.prod).
ALLOWED_HOSTS=@ALLOWED_HOSTS@
CONTROL_DATABASE_URL=postgres://predictive_app:@PREDICTIVE_DB_PASSWORD@@db:5432/predictive_control
DEFAULT_TENANT=@TENANT@
REDIS_URL=redis://redis:6379/0
# Los archivos viven en el volumen de datos del servidor.
MEDIA_BACKEND=local
MEDIA_ROOT=data/media
HISTORY_ROOT=data/history
EXPORT_ROOT=data/exports
# Identidad de esta instalación y su fecha recordada (Fase 2).
INSTALLATION_FILE=data/installation.json
# Renovación en línea (Fase 3): vacío = solo por archivo, el servidor nunca
# sale a internet. Si su TI lo permite, la URL de nuestro servicio.
LICENSE_RENEW_URL=
